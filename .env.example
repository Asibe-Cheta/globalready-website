# Stripe (required for Pro checkout)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PRICE_SEVEN_DAY=price_xxx
STRIPE_PRICE_MONTHLY_PRO=price_xxx
STRIPE_PRICE_FOUR_MONTH_PRO=price_xxx
STRIPE_PRICE_YEARLY_PRO=price_xxx
# Backward-compatible fallback for Monthly Pro:
STRIPE_PRICE_ID=price_xxx

# Supabase (required for email→user lookup when subscribing without uid)
# Project Settings → API: Project URL and service_role key
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Base URL for Stripe success/cancel redirects (default: https://globalready.tech)
NEXT_PUBLIC_APP_URL=https://globalready.tech

# Selar product codes (enables "Pay with Selar" on /upgrade; 7-day is Stripe-only)
NEXT_PUBLIC_SELAR_PRODUCT_MONTHLY_PRO=r636f00tdn
NEXT_PUBLIC_SELAR_PRODUCT_FOUR_MONTH_PRO=3c740226s3
NEXT_PUBLIC_SELAR_PRODUCT_YEARLY_PRO=c899qx619s

STRIPE_PRICE_SEVEN_DAY=
STRIPE_PRICE_MONTHLY_PRO=
STRIPE_PRICE_FOUR_MONTH_PRO=
STRIPE_PRICE_YEARLY_PRO=
